# DiNho Optimizer — Environment Variables Template
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# GitHub Personal Access Token — SOMENTE para publicar releases localmente.
# optdinho/dinhoopt é repo PÚBLICO, então o auto-updater em runtime NÃO precisa
# de token: ele lê o feed .atom anonimamente (por isso `private: false` no
# electron-builder.yml). Este token é usado por `npm run publish` /
# electron-builder, que grava no repo e por isso exige escrita.
#
# Classic: https://github.com/settings/tokens  (escopos: repo + workflow)
# Fine-grained: https://github.com/settings/personal-access-tokens
#   (repo: dinhoopt -> Contents: Read and write)
#
# IMPORTANTE: o electron-builder lê GH_TOKEN do SHELL, não do .env:
#   $env:GH_TOKEN = "ghp_..."
#   npm run publish
GH_TOKEN=ghp_your_token_here

# License API endpoint (optional — for future licensing)
LICENSE_API_URL=https://your-license-api.example.com
LICENSE_API_TOKEN=your_license_token_here

# E2E license bypass key (optional — dev/CI only). When DINHO_E2E=1 AND this
# secret is set at build time AND the userData marker file exists, the license
# check is bypassed for Playwright runs. Never set this in production.
DINHO_E2E_KEY=

