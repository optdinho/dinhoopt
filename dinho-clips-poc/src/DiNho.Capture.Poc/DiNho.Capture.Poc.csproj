<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Esta fase é Windows-only por natureza: DXGI e WGC não existem em outras plataformas. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>DiNho.Capture.Poc</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Ícone do app embutido no exe: sem isto o Windows mostra o ícone padrão de exe.
         Mesmo ícone do app (resources/icon.ico), copiado para junto do projeto. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <!-- Necessário para usar a projeção do Windows.Graphics.Capture via CsWinRT -->
    <UseWinUI>false</UseWinUI>
    <!-- .NET 10 projections Windows.Graphics.Capture and Direct3D11 natively — no CsWinRT needed -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Bindings de DXGI / Direct3D11 / D3D11 device, sem precisar escrever P/Invoke manual para tudo -->
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />

    <!-- .NET 10 projects Windows.Graphics.Capture and Direct3D11 natively — CsWinRT package no longer needed -->

    <!-- Media Foundation — MANTIDO com uso real, mas MUITO mais restrito do que esta
         comment original sugeria ("encoder MFT + Sink Writer" — a migração MF→ffmpeg
         removeu o SinkWriter e os MFT de encode). Uso actual (verificado por grep em
         2026-10-19, item 20 da Fase 1 Clips):
           · MediaFactory.MFStartup/MFShutdown — singleton no StartAsync/StopAsync do
             EngineCoordinator (guardado por _mfStarted) e no ProgramBenchmark;
           · MediaFactory.MFCreateDXGIDeviceManager + ResetDevice — EngineCoordinator.Capture.cs
             (arranque da captura e recuperação após device lost/TDR);
           · IMFDXGIDeviceManager — tipo no campo _dxgiManager e na assinatura
             IEncoder.SetD3DManager (esta última é no-op SEM chamadores — resto da
             migração; o encoder ffmpeg não consome o manager).
         Remover o PackageReference exige remover esses call sites (comportamento de
         arranque/encerramento muda), não só a linha do csproj. -->
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />

    <!-- CsWin32 source generator — auto-generated P/Invoke bindings -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.363">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- WASAPI audio capture -->
    <PackageReference Include="NAudio" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="games.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ApplicationLoopback.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DiNho.Capture.Poc.Tests" />
  </ItemGroup>

</Project>
