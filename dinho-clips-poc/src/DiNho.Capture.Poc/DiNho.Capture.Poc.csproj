<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Esta fase é Windows-only por natureza: DXGI e WGC não existem em outras plataformas. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>DiNho.Capture.Poc</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Necessário para usar a projeção do Windows.Graphics.Capture via CsWinRT -->
    <UseWinUI>false</UseWinUI>
    <CsWinRTIncludes>Windows.Graphics.Capture;Windows.Graphics.DirectX.Direct3D11</CsWinRTIncludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bindings de DXGI / Direct3D11 / D3D11 device, sem precisar escrever P/Invoke manual para tudo -->
    <PackageReference Include="Vortice.DXGI" Version="3.5.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.5.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.5.0" />

    <!-- Projeção do WinRT necessária para Windows.Graphics.Capture -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />

    <!-- Media Foundation (encoder MFT + Sink Writer) -->
    <PackageReference Include="Vortice.MediaFoundation" Version="3.5.0" />

    <!-- WASAPI audio capture -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="games.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ApplicationLoopback.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DiNho.Capture.Poc.Tests" />
  </ItemGroup>

</Project>
