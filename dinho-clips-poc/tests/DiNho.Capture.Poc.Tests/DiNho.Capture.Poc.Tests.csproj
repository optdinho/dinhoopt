<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3: o projecto de testes e um executavel autonomo (v2 era uma
         library carregada pelo runner). Migrado de xunit 2.9.3 (Legacy)
         em 2026-10-19 - ver docs/plans/xunit-v3-migration-2026-10-19.md -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- coverlet.collector removido em 2026-10-06: declarado mas nunca
         invocado (nenhum script de teste usa collector nem CollectCoverage) -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <!-- Microsoft.NET.Test.Sdk + xunit.runner.visualstudio (VSTest) removidos em 2026-10-19:
         em .NET 10 o "dotnet test" usa exclusivamente Microsoft.Testing.Platform (opt-in no
         global.json) e misturar VSTest com MTP nao e suportado. Ver plano da migracao. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DiNho.Capture.Poc\DiNho.Capture.Poc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\DiNho.Capture.Poc\games.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
