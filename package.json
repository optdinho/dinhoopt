{
  "name": "dinho-optimizer",
  "version": "2.1.14",
  "description": "DiNho Optimizer — Otimizador de sistema Windows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/optdinho/dinhoopt.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run copy-engine && electron-vite build && electron-builder --win",
    "publish": "npm run copy-engine && npm run release:notes && electron-vite build && npm run release:ensure && electron-builder --win --publish always",
    "release:notes": "node scripts/gen-release-notes.js",
    "release:ensure": "node scripts/ensure-release.js",
    "release:readme": "node scripts/sync-releases-readme.js",
    "copy-engine": "node scripts/copy-engine.js",
    "build:ffmpeg": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-ffmpeg.ps1",
    "verify:ffmpeg": "node scripts/verify-ffmpeg.js --ffmpeg resources/clips-engine-staging/ffmpeg.exe",
    "verify:release": "node scripts/verify-release.js --skip-download",
    "verify:release:full": "node scripts/verify-release.js",
    "test": "vitest run",
    "test:failed": "vitest run --lastFailed",
    "test:changed": "vitest run --sinceLastRun",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.cjs",
    "test:harness": "vitest run --config vitest.harness.config.mts",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "clean": "node -e \"const{f}=require('fs');['out','dist','coverage'].forEach(d=>f.rmSync(d,{recursive:true,force:true}))\"",
    "audit": "npm audit --audit-level=high",
    "validate:rules": "npx tsx src/main/rules/validate.ts",
    "new-rule": "node scripts/new-rule.js",
    "find-cache": "node scripts/find-cache.js",
    "preview-rule": "node scripts/preview-rule.js"
  },
  "keywords": [
    "system-cleaner",
    "electron",
    "windows",
    "optimization"
  ],
  "author": "DiNho <contato@dinhooptimizer.com>",
  "license": "Commercial",
  "devDependencies": {
    "@axe-core/react": "^4.14.1",
    "@biomejs/biome": "^2.6.9",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@litko/yara-x": "^0.13.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "electron-updater": "^6.8.11",
    "framer-motion": "^14.14.0",
    "i18next": "^27.2.7",
    "lucide-react": "^1.79.0",
    "node-machine-id": "^1.1.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.7",
    "recharts": "^3.11.1",
    "sonner": "^2.0.8",
    "systeminformation": "^5.33.26",
    "tailwind-merge": "^3.7.1",
    "zustand": "^5.1.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/optdinho/dinhoopt-releases/issues"
  },
  "homepage": "https://dinhooptimizer.netlify.app/"
}
